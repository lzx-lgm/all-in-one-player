{
  "name": "all-in-one-player",
  "version": "1.0.7",
  "private": false,
  "description": "全能播放器 OmniRadio+：Mineradio 式沉浸视觉舞台 + 8 平台聚合音乐，独有 MV/视频原始格式、原始分辨率直通播放。网页版（PWA）与 Electron 桌面版同一套代码。",
  "homepage": "https://github.com/lzx-lgm/all-in-one-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/lzx-lgm/all-in-one-player.git"
  },
  "license": "MIT",
  "author": "lzx-lgm <2221278893@qq.com>",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/server.js && node --check electron/preload.js && node --check js/app.js && echo syntax-ok",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.lzxlgm.allinoneplayer",
    "productName": "AllInOnePlayer",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-universal.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "lzx-lgm <2221278893@qq.com>",
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
